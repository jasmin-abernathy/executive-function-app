Options -Indexes
DirectoryIndex index.php

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; font-src 'self'; form-action 'self'; frame-ancestors 'none'; base-uri 'self'"
</IfModule>

<FilesMatch "^(config\.php|config\.example\.php|README\.md|DEPLOYMENT-CHECKLIST\.md|CHANGE-QUESTIONS\.md)$">
  Require all denied
</FilesMatch>

RewriteEngine On
RewriteRule ^(?:includes|sql|storage)/ - [F,L]
